NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5400
DB_USERNAME=admin
DB_PASSWORD=change_me
DB_DATABASE=toeic_path_ai_db
DB_SSL=false
DB_LOGGING=false

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=16kb

SECURITY_EVENT_LOGGING_ENABLED=true
SECURITY_EVENT_LOG_LEVEL=info
SECURITY_EVENT_HMAC_KEY=replace-with-at-least-32-random-characters
SECURITY_EVENT_USER_AGENT_MAX_LENGTH=500
SECURITY_EVENT_INCLUDE_IP=true
SECURITY_EVENT_LOGIN_FAILURE_SAMPLE_RATE=1

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_TTL_SECONDS=900
RATE_LIMIT_REGISTER_IP_MAX=5
RATE_LIMIT_LOGIN_TTL_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_EMAIL_FAILURE_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_TTL_SECONDS=900
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_MAX=3
RATE_LIMIT_RESET_PASSWORD_TTL_SECONDS=900
RATE_LIMIT_RESET_PASSWORD_IP_MAX=5
RATE_LIMIT_RESET_PASSWORD_TOKEN_MAX=5
RATE_LIMIT_REFRESH_TTL_SECONDS=300
RATE_LIMIT_REFRESH_IP_MAX=60
RATE_LIMIT_REFRESH_SESSION_MAX=20
RATE_LIMIT_LOGOUT_TTL_SECONDS=300
RATE_LIMIT_LOGOUT_MAX=30

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PRIVATE_KEY_PATH=./keys/private.key
JWT_PUBLIC_KEY_PATH=./keys/public.key
BCRYPT_SALT_ROUNDS=12
TERMS_VERSION=2026-08-31
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-admin-password
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

REFRESH_COOKIE_NAME=toeic_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_MAX_AGE_MS=604800000
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

AUTH_SESSION_CLEANUP_ENABLED=true
AUTH_SESSION_RETENTION_DAYS=7
AUTH_SESSION_CLEANUP_BATCH_SIZE=1000
AUTH_SESSION_CLEANUP_MAX_BATCHES=100
AUTH_SESSION_CLEANUP_CRON=0 0 2 * * *

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/reset-password
MAIL_FROM=no-reply@toeicpath.local

STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_MEDIA=media
AVATAR_MAX_SIZE_BYTES=2097152
AVATAR_MAX_WIDTH=2048
AVATAR_MAX_HEIGHT=2048
AVATAR_OUTPUT_WIDTH=512
AVATAR_OUTPUT_HEIGHT=512
AVATAR_OUTPUT_FORMAT=webp
AVATAR_OUTPUT_QUALITY=85
