      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 5 seconds', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
          "if (pm.response.code !== 204) { pm.test('Response body is valid JSON', function () { pm.expect(function () { pm.response.json(); }).not.to.throw(); }); }",
          "if (pm.response.code >= 400) { pm.test('Error does not expose implementation details', function () { const raw = pm.response.text().toLowerCase(); ['password_hash', 'queryfailed', 'stacktrace', 'node_modules'].forEach((value) => pm.expect(raw).not.to.include(value)); }); }"
        ]
      }
    }
