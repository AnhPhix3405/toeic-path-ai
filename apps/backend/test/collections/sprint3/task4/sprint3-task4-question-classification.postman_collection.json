  "item": [
    {
      "name": "00 - Setup",
      "description": "Điền adminEmail/adminPassword trước khi chạy. Folder tạo tài khoản test, nâng role Teacher, lấy catalog IDs theo tên và tạo hai Question.",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sprint 3 Task 4 Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.expect(pm.response.code).to.be.oneOf([201, 409]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Teacher Candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sprint 3 Task 4 Teacher\",\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.expect(pm.response.code).to.be.oneOf([201, 409]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('studentToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.user.role).to.eql('admin'); pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find Teacher Candidate",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/users?search={{teacherEmail}}&page=1&limit=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const user = pm.response.json().data.find((item) => item.email === pm.collectionVariables.get('teacherEmail'));",
                  "pm.expect(user, 'Teacher candidate must exist').to.exist; pm.collectionVariables.set('teacherUserId', user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Promote Teacher Candidate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"teacher\"}"
            },
            "url": "{{baseUrl}}/admin/users/{{teacherUserId}}/role",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().role).to.eql('teacher');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{teacherEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.user.role).to.eql('teacher'); pm.collectionVariables.set('teacherToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Load TOEIC Parts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/toeic-parts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body).to.have.length(7); pm.expect(body.map((item) => item.partNumber)).to.eql([1,2,3,4,5,6,7]);",
                  "const part5 = body.find((item) => item.partNumber === 5); const part6 = body.find((item) => item.partNumber === 6); pm.expect(part5).to.exist; pm.expect(part6).to.exist; pm.collectionVariables.set('part5Id', part5.id); pm.collectionVariables.set('part6Id', part6.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Load Topics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/topics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body).to.have.length(6); ['Business','Office','Travel','Shopping','Transportation','Technology'].forEach((name) => pm.expect(body.some((item) => item.name === name), name).to.eql(true));",
                  "pm.collectionVariables.set('businessTopicId', body.find((item) => item.name === 'Business').id); pm.collectionVariables.set('officeTopicId', body.find((item) => item.name === 'Office').id); pm.collectionVariables.set('travelTopicId', body.find((item) => item.name === 'Travel').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Load Skills",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/skills"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body).to.have.length(6); ['Grammar','Vocabulary','Listening Comprehension','Reading Comprehension','Inference','Detail Recognition'].forEach((name) => pm.expect(body.some((item) => item.name === name), name).to.eql(true));",
                  "pm.collectionVariables.set('grammarSkillId', body.find((item) => item.name === 'Grammar').id); pm.collectionVariables.set('vocabularySkillId', body.find((item) => item.name === 'Vocabulary').id); pm.collectionVariables.set('readingSkillId', body.find((item) => item.name === 'Reading Comprehension').id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Teacher Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"[S3T4] The manager _____ the report yesterday.\",\"questionType\":\"single_choice\"}"
            },
            "url": "{{baseUrl}}/questions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "const body = pm.response.json(); pm.expect(body.part).to.be.null; pm.expect(body.difficulty).to.be.null; pm.expect(body.topics).to.eql([]); pm.expect(body.skills).to.eql([]); pm.collectionVariables.set('questionId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Admin Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"[S3T4] Admin owned classification question.\",\"questionType\":\"single_choice\"}"
            },
            "url": "{{baseUrl}}/questions",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "pm.collectionVariables.set('adminQuestionId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Classification lifecycle",
      "item": [
        {
          "name": "TC01 - Owner assigns multiple Topics and Skills",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partId\": \"{{part5Id}}\",\n  \"topicIds\": [\"{{businessTopicId}}\", \"{{officeTopicId}}\"],\n  \"skillIds\": [\"{{grammarSkillId}}\", \"{{vocabularySkillId}}\"],\n  \"difficulty\": \"medium\"\n}"
            },
            "url": "{{baseUrl}}/questions/{{questionId}}/classification"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.part.partNumber).to.eql(5); pm.expect(body.difficulty).to.eql('medium'); pm.expect(body.topics.map((item) => item.name).sort()).to.eql(['Business','Office']); pm.expect(body.skills.map((item) => item.name).sort()).to.eql(['Grammar','Vocabulary']);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC02 - Detail returns populated classification",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/questions/{{questionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.part).to.include({ partNumber: 5, name: 'Incomplete Sentences' }); pm.expect(body.difficulty).to.eql('medium'); pm.expect(body.topics).to.have.length(2); pm.expect(body.skills).to.have.length(2);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC03 - PUT replaces the whole classification",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partId\": \"{{part6Id}}\",\n  \"topicIds\": [\"{{travelTopicId}}\"],\n  \"skillIds\": [\"{{readingSkillId}}\"],\n  \"difficulty\": \"hard\"\n}"
            },
            "url": "{{baseUrl}}/questions/{{questionId}}/classification"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.part.partNumber).to.eql(6); pm.expect(body.difficulty).to.eql('hard'); pm.expect(body.topics.map((item) => item.name)).to.eql(['Travel']); pm.expect(body.skills.map((item) => item.name)).to.eql(['Reading Comprehension']);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC04 - Question Bank list includes classification summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/questions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const question = pm.response.json().find((item) => item.id === pm.collectionVariables.get('questionId')); pm.expect(question, 'Created question must be listed').to.exist; pm.expect(question.part.partNumber).to.eql(6); pm.expect(question.difficulty).to.eql('hard'); pm.expect(question.topics.map((item) => item.name)).to.eql(['Travel']); pm.expect(question.skills.map((item) => item.name)).to.eql(['Reading Comprehension']);"
                ]
              }
            }
          ]
        }
      ]
    },
