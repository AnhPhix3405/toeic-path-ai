  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 5 seconds', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
          "if (pm.response.code !== 204) { pm.test('Response body is valid JSON', function () { pm.expect(function () { pm.response.json(); }).not.to.throw(); }); }",
          "if (pm.response.code >= 400) {",
          "  pm.test('Error does not expose implementation details or secrets', function () {",
          "    const raw = pm.response.text().toLowerCase();",
          "    ['password_hash', 'refreshtokenhash', 'node_modules', 'queryfailed', 'stacktrace'].forEach((value) => pm.expect(raw).not.to.include(value));",
          "  });",
          "}",
          "const isQuestionSuccess = [200, 201].includes(pm.response.code) && pm.request.url.toString().includes('/questions');",
          "if (isQuestionSuccess) {",
          "  const payload = pm.response.json(); const rows = Array.isArray(payload) ? payload : [payload];",
          "  rows.forEach((body) => {",
          "    pm.expect(body).to.have.all.keys('id', 'content', 'questionType', 'status', 'createdAt', 'updatedAt');",
          "    pm.expect(body.questionType).to.eql('single_choice'); pm.expect(body.status).to.eql('draft');",
          "    ['createdBy', 'creator', 'passwordHash'].forEach((key) => pm.expect(body).not.to.have.property(key));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "description": "Điền adminEmail và adminPassword trước khi chạy. Setup tạo Student, tạo ứng viên Teacher, dùng Admin để gán role teacher rồi đăng nhập lấy token.",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sprint 3 Task 1 Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Student is created or already exists', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Teacher Candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Sprint 3 Task 1 Teacher\",\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\",\n  \"acceptTerms\": true\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Teacher candidate is created or already exists', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.user.role).to.eql('student'); pm.collectionVariables.set('studentToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.user.role).to.eql('admin'); pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find Teacher Candidate",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users?search={{teacherEmail}}&page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const rows = pm.response.json().data; const user = rows.find((item) => item.email === pm.collectionVariables.get('teacherEmail'));",
                  "pm.expect(user, 'Teacher candidate must exist').to.exist; pm.collectionVariables.set('teacherUserId', user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Promote Teacher Candidate",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"teacher\"\n}" },
            "url": "{{baseUrl}}/admin/users/{{teacherUserId}}/role"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().role).to.eql('teacher');"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json(); pm.expect(body.user.role).to.eql('teacher');",
                  "pm.collectionVariables.set('teacherToken', body.accessToken); pm.collectionVariables.set('teacherUserId', body.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
