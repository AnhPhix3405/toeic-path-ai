    {
      "name": "03 - Synchronous Bulk Import (< 100 rows)",
      "item": [
        {
          "name": "Upload Small Excel (< 100 rows) -> 201 Created Sync",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Result indicates synchronous execution', function () {",
                  "    pm.expect(json.isAsync).to.be.false;",
                  "    pm.expect(json.jobId).to.be.a('string');",
                  "});",
                  "if (json.jobId) {",
                  "    pm.collectionVariables.set('jobId', json.jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "apps/backend/test/fixtures/questions_valid_small.xlsx"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/import?targetStatus=draft",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "import"],
              "query": [{ "key": "targetStatus", "value": "draft" }]
            }
          }
        },
        {
          "name": "Verify Part 1 Auto-Generated Options (4 Options, Empty Content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var list = json.data || json.items || [];",
                  "var q = list.find(function(item) { return item.explanation === 'Audio explanation for Part 1'; }) || list[0];",
                  "pm.test('Part 1 question has null content and exactly 4 auto-generated options', function () {",
                  "    pm.expect(q).to.be.an('object');",
                  "    pm.expect(q.content).to.be.oneOf([null, '']);",
                  "    pm.expect(q.options).to.be.an('array').with.lengthOf(4);",
                  "    var labels = q.options.map(function(o) { return o.label; });",
                  "    var positions = q.options.map(function(o) { return o.position; });",
                  "    pm.expect(labels).to.eql(['A', 'B', 'C', 'D']);",
                  "    pm.expect(positions).to.eql([1, 2, 3, 4]);",
                  "    q.options.forEach(function(opt) {",
                  "        pm.expect(opt.content).to.be.oneOf([null, '']);",
                  "    });",
                  "    var optA = q.options.find(function(o) { return o.label === 'A'; });",
                  "    pm.expect(optA.isCorrect).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions?search=Audio%20explanation%20for%20Part%201",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"],
              "query": [{ "key": "search", "value": "Audio explanation for Part 1" }]
            }
          }
        },
        {
          "name": "Verify Part 2 Auto-Generated Options (3 Options, No Option D)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var list = json.data || json.items || [];",
                  "var q = list.find(function(item) { return item.explanation === 'Audio explanation for Part 2'; }) || list[0];",
                  "pm.test('Part 2 question has null content, exactly 3 options, and no option D', function () {",
                  "    pm.expect(q).to.be.an('object');",
                  "    pm.expect(q.content).to.be.oneOf([null, '']);",
                  "    pm.expect(q.options).to.be.an('array').with.lengthOf(3);",
                  "    var labels = q.options.map(function(o) { return o.label; });",
                  "    var positions = q.options.map(function(o) { return o.position; });",
                  "    pm.expect(labels).to.eql(['A', 'B', 'C']);",
                  "    pm.expect(positions).to.eql([1, 2, 3]);",
                  "    pm.expect(labels.indexOf('D')).to.eql(-1);",
                  "    q.options.forEach(function(opt) {",
                  "        pm.expect(opt.content).to.be.oneOf([null, '']);",
                  "    });",
                  "    var optB = q.options.find(function(o) { return o.label === 'B'; });",
                  "    pm.expect(optB.isCorrect).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions?search=Audio%20explanation%20for%20Part%202",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions"],
              "query": [{ "key": "search", "value": "Audio explanation for Part 2" }]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Group Atomicity Rollback & Whitelist Checks",
      "item": [
        {
          "name": "Upload Group with 1 Error -> Entire Group Rollback",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Created groups count is 0 due to atomic rollback', function () {",
                  "    pm.expect(json.createdGroupsCount).to.eql(0);",
                  "    pm.expect(json.errorCount).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "apps/backend/test/fixtures/questions_group_invalid.xlsx"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "import"]
            }
          }
        }
      ]
    },
