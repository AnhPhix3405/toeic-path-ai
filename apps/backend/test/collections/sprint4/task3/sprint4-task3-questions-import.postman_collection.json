    {
      "name": "06 - Submit For Review (Group Atomicity)",
      "item": [
        {
          "name": "POST Submit for Review Bulk",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.variables.get('baseUrl') + '/api/v1/questions?page=1&limit=5',",
                  "    method: 'GET',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + pm.variables.get('teacherToken')",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        var body = res.json();",
                  "        var list = body.data || body.items || [];",
                  "        if (list.length > 0) {",
                  "            var draftQ = list.find(function(item) { return item.status === 'draft'; }) || list[0];",
                  "            pm.collectionVariables.set('sampleQuestionId', draftQ.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Response contains submittedCount and skipped array', function () {",
                  "    pm.expect(json.submittedCount).to.be.a('number');",
                  "    pm.expect(json.submittedIds).to.be.an('array');",
                  "    pm.expect(json.skipped).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionIds\": [\"{{sampleQuestionId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/import/submit-for-review",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "import", "submit-for-review"]
            }
          }
        }
      ]
    },
