    {
      "name": "02 - Review Queue Retrieval",
      "item": [
        {
          "name": "Get Review Queue (Teacher 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Has items and pagination metadata', function () {",
                  "    pm.expect(json).to.have.property('items');",
                  "    pm.expect(json).to.have.property('total');",
                  "});",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('targetQuestionId', json.items[0].id);",
                  "    pm.collectionVariables.set('targetQuestionVersion', json.items[0].version || 1);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacher2Token}}" }],
            "url": {
              "raw": "{{baseUrl}}/questions/reviews/queue?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["questions", "reviews", "queue"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Maker-Checker Defense",
      "item": [
        {
          "name": "Teacher 1 Self-Review Attempt (Must Fail 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Error code is ERR_CANNOT_SELF_REVIEW', function () {",
                  "    pm.expect(json.code || json.message).to.include('ERR_CANNOT_SELF_REVIEW');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{teacher1Token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{targetQuestionVersion}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/questions/reviews/{{targetQuestionId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["questions", "reviews", "{{targetQuestionId}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Admin Emergency Bypass",
      "item": [
        {
          "name": "Admin Approve With Emergency Bypass (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Question is published and version incremented', function () {",
                  "    pm.expect(json.status).to.eql('published');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{targetQuestionVersion}},\n  \"emergencyBypass\": true,\n  \"feedback\": \"Admin emergency approval for hotfix\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/questions/reviews/{{targetQuestionId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["questions", "reviews", "{{targetQuestionId}}", "approve"]
            }
          }
        }
      ]
    },
