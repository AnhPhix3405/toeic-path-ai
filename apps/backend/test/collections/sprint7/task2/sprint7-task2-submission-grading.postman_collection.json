    {
      "name": "02 - Review-Only Skipped Answer Accuracy, ETS Grading & Idempotency (DT, ST)",
      "item": [
        {
          "name": "TC-T2-04a [Setup] Save Correct (Q1), Wrong (Q2), and Review-Only Skipped (Q3 selectedOptionId=null)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{q1Id}}\",\n      \"selectedOptionId\": \"{{q1OptCorrect}}\",\n      \"isMarkedForReview\": false,\n      \"timeSpentSeconds\": 12\n    },\n    {\n      \"questionId\": \"{{q2Id}}\",\n      \"selectedOptionId\": \"{{q2OptWrong}}\",\n      \"isMarkedForReview\": false,\n      \"timeSpentSeconds\": 20\n    },\n    {\n      \"questionId\": \"{{q3Id}}\",\n      \"selectedOptionId\": null,\n      \"isMarkedForReview\": true,\n      \"timeSpentSeconds\": 8\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers/batch"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Batch save 3 answers (including review-only null option) returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().syncedCount).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T2-04b [Positive - DT] Submit Attempt Counts Review-Only Row as Skipped (NOT Wrong) & Computes ETS Score",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T2-04b] Review-only answer (selectedOptionId=null) is counted in skippedCount=2, wrongCount=1, correctCount=1', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('submitted');",
                  "    pm.expect(res.totalQuestions).to.eql(4);",
                  "    pm.expect(res.correctCount).to.eql(1);",
                  "    pm.expect(res.wrongCount).to.eql(1);",
                  "    pm.expect(res.skippedCount).to.eql(2);",
                  "    pm.expect(res.accuracyPercentage).to.eql(25);",
                  "    pm.expect(res.listeningScore).to.be.within(5, 495);",
                  "    pm.expect(res.readingScore).to.be.within(5, 495);",
                  "    pm.expect(res.totalScore).to.eql(res.listeningScore + res.readingScore);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T2-05 [Negative - ST] Double-Click / Duplicate Submit Returns 409 ERR_ATTEMPT_ALREADY_SUBMITTED With Metadata",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{student1Token}}" }],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T2-05] Second submit on already submitted attempt returns 409 with status and submittedAt', function () {",
                  "    pm.response.to.have.status(409);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.errorCode).to.eql('ERR_ATTEMPT_ALREADY_SUBMITTED');",
                  "    pm.expect(res.status).to.eql('submitted');",
                  "    pm.expect(res.submittedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
