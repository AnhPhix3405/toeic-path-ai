                  "pm.test('[TC-T2-09b] Single-skill Listening exam sets listeningScore=5, readingScore=null, totalScore=null, isPassed=null', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.listeningScore).to.eql(5);",
                  "    pm.expect(res.readingScore).to.be.null;",
                  "    pm.expect(res.totalScore).to.be.null;",
                  "    pm.expect(res.isPassed).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T2-10 [Boundary - BVA/ST] Expired Attempt Past 30s Grace Period Transitions to timed_out With Capped durationSpentSeconds",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{student3Token}}" }],
            "url": "{{baseUrl}}/exam-attempts/{{expiredAttemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T2-10] Expired attempt transitions to timed_out (200 via late submit or 409 if collected by Cron UC24)', function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('timed_out');",
                  "    if (pm.response.code === 200) {",
