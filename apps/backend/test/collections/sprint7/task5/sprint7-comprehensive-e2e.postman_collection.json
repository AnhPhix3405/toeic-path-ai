        {
          "name": "02.4 - Review Wrong Answers & Verify Post-Filter Group Deduplication (UC28)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/review?filter=wrong"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /review?filter=wrong returns filterCounts and deduplicates questionGroups after filtering', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.filterCounts).to.eql({ all: 4, correct: 2, wrong: 1, skipped: 1, marked: 1 });",
                  "    pm.expect(res.questions).to.be.an('array').with.lengthOf(1);",
                  "    pm.expect(res.questions[0].id).to.eql(pm.collectionVariables.get('q2Id'));",
                  "    pm.expect(res.questionGroups).to.be.an('array').with.lengthOf(1);",
                  "    pm.expect(res.questionGroups[0].title).to.eql('TEST_POSTMAN_SPR7_Group_Part_3');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02.5 - Review Part 1 & Verify Rule #1002 Nullable Content",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/review?partNumber=1&filter=all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Part 1 review preserves null content per Rule #1002', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.questions).to.have.lengthOf(1);",
