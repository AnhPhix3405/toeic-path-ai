    {
      "name": "03 - Timed-Out Submit, Part Practice, RAW_PERCENTAGE & Abandon Guardrails",
      "item": [
        {
          "name": "03.1 - Submit Expired Attempt Past 30s Grace Period -> timed_out (Student 3)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student3Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{expiredAttemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expired attempt transitions to timed_out (200 via late submit or 409 if already auto-collected by Cron UC24)', function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('timed_out');",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(res.durationSpentSeconds).to.eql(7200);",
                  "    } else {",
                  "        pm.expect(res.errorCode).to.eql('ERR_ATTEMPT_ALREADY_SUBMITTED');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03.1b - Verify Expired Attempt Result Summary Has status=timed_out & durationSpentSeconds=7200",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student3Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{expiredAttemptId}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Expired attempt result has status=timed_out and capped durationSpentSeconds=7200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('timed_out');",
                  "    pm.expect(res.durationSpentSeconds).to.eql(7200);",
                  "});"
                ]
              }
            }
          ]
        },
