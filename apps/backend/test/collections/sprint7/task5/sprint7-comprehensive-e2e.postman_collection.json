    {
      "name": "01 - Full Exam Attempt, Manual Submit & ETS Grading (UC20, UC22, UC23, UC25)",
      "item": [
        {
          "name": "01.1 - Start Full Exam Attempt (Student 1)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{fullExamId}}\",\n  \"mode\": \"full_exam\"\n}"
            },
            "url": "{{baseUrl}}/exam-attempts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Start Full Exam Attempt returns 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.attemptId).to.be.a('string');",
                  "    pm.expect(res.totalQuestions).to.eql(4);",
                  "    pm.collectionVariables.set('attemptId', res.attemptId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 - Guard: Block View Result Before Submit (400 ERR_ATTEMPT_NOT_SUBMITTED)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Viewing result while in_progress returns 400 ERR_ATTEMPT_NOT_SUBMITTED', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_ATTEMPT_NOT_SUBMITTED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.3 - Save Answers (Correct Q1, Wrong+Marked Q2, Correct Q3, Skipped Q4)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{q1Id}}\",\n      \"selectedOptionId\": \"{{q1OptCorrect}}\",\n      \"isMarkedForReview\": false,\n      \"timeSpentSeconds\": 15\n    },\n    {\n      \"questionId\": \"{{q2Id}}\",\n      \"selectedOptionId\": \"{{q2OptWrong}}\",\n      \"isMarkedForReview\": true,\n      \"timeSpentSeconds\": 25\n    },\n    {\n      \"questionId\": \"{{q3Id}}\",\n      \"selectedOptionId\": \"{{q3OptCorrect}}\",\n      \"isMarkedForReview\": false,\n      \"timeSpentSeconds\": 20\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers/batch"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Batch save answers returns 200 OK with syncedCount=3', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.syncedCount).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.4 - Guard: Non-Owner Cannot Submit Attempt (403 ERR_FORBIDDEN_ATTEMPT_ACCESS)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student2Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Student 2 submitting Student 1 attempt returns 403 ERR_FORBIDDEN_ATTEMPT_ACCESS', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_FORBIDDEN_ATTEMPT_ACCESS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.5 - Submit Full Exam Attempt & Trigger ETS Grading (UC23 & UC25)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Submit attempt returns 200 OK with ETS scores and counts', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.attemptId).to.eql(pm.collectionVariables.get('attemptId'));",
                  "    pm.expect(res.status).to.eql('submitted');",
                  "    pm.expect(res.totalQuestions).to.eql(4);",
                  "    pm.expect(res.correctCount).to.eql(2);",
                  "    pm.expect(res.wrongCount).to.eql(1);",
                  "    pm.expect(res.skippedCount).to.eql(1);",
                  "    pm.expect(res.accuracyPercentage).to.eql(50);",
                  "    pm.expect(res.listeningScore).to.be.a('number');",
                  "    pm.expect(res.readingScore).to.be.a('number');",
                  "    pm.expect(res.totalScore).to.eql(res.listeningScore + res.readingScore);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.6 - Guard: Duplicate Submit Returns 409 ERR_ATTEMPT_ALREADY_SUBMITTED",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/{{attemptId}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Submitting already submitted attempt returns 409 ERR_ATTEMPT_ALREADY_SUBMITTED', function () {",
                  "    pm.response.to.have.status(409);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.errorCode).to.eql('ERR_ATTEMPT_ALREADY_SUBMITTED');",
                  "    pm.expect(res.status).to.eql('submitted');",
                  "    pm.expect(res.submittedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
