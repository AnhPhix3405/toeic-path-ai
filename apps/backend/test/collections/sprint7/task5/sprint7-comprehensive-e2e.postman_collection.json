        {
          "name": "02.2 - View Exam Attempt History Paginated (UC27)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "url": "{{baseUrl}}/exam-attempts/history?page=1&limit=10&examId={{fullExamId}}&mode=full_exam&status=submitted&fromDate=2020-01-01&toDate=2099-12-31"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /history returns flat paginated envelope excluding JSONB columns', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.total).to.be.at.least(1);",
                  "    pm.expect(res.items[0].attemptId).to.eql(pm.collectionVariables.get('attemptId'));",
                  "    pm.expect(res.items[0]).to.not.have.property('partBreakdown');",
                  "    pm.expect(res.items[0]).to.not.have.property('skillBreakdown');",
                  "});"
                ]
              }
            }
          ]
        },
