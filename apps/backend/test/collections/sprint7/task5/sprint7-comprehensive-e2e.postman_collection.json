                  "    const res = pm.response.json();",
                  "    pm.expect(res.attemptId).to.eql(pm.collectionVariables.get('attemptId'));",
                  "    pm.expect(res.scoreConversionType).to.eql('DEFAULT_ETS');",
                  "    pm.expect(res.partBreakdown).to.be.an('array').with.lengthOf(4);",
