          "name": "02.1 - View Exam Attempt Result Summary & Breakdowns (UC26)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
