          "name": "TC-T3-12c [Negative - EP] Review Rejects Part Not Selected in Part Practice (400 ERR_PART_NOT_IN_ATTEMPT)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{student2Token}}" }],
            "url": "{{baseUrl}}/exam-attempts/{{partPracticeAttemptId}}/review?partNumber=7"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T3-12c] Requesting Part 7 on Part 5 practice review returns 400 ERR_PART_NOT_IN_ATTEMPT', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_PART_NOT_IN_ATTEMPT');",
                  "});"
