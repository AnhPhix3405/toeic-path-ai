                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_QUESTION_NOT_IN_ATTEMPT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-04 [Positive - BVA] Create Report At Exact Lower Boundary (10 Chars After Trim) With Valid attemptId (201 Created)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"other\",\n  \"description\": \"  1234567890  \",\n  \"attemptId\": \"{{submittedAttemptId}}\"\n}"
            },
            "url": "{{baseUrl}}/questions/{{q2Id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-04] 10-character trimmed description at lower boundary returns 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('pending');",
                  "    pm.expect(res.description).to.eql('1234567890');",
                  "    pm.collectionVariables.set('report1Id', res.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-05 [Negative - Anti-Spam Index] Duplicate Open Report Blocked By Partial Unique Index (409 ERR_DUPLICATE_OPEN_REPORT)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"typo_error\"\n}"
            },
            "url": "{{baseUrl}}/questions/{{q2Id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-05] Duplicate open report on same question returns 409 ERR_DUPLICATE_OPEN_REPORT', function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_DUPLICATE_OPEN_REPORT');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - RBAC Guards, Moderation State Machine, Bulk Resolution & Student Feedback Loop (UC29 & UC49 - ST, DT)",
      "item": [
        {
          "name": "TC-T4-06 [Negative - RBAC] Student Forbidden From Resolving Question Report (403 Forbidden)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"resolutionNote\": \"Student trying to resolve own report.\"\n}"
            },
            "url": "{{baseUrl}}/question-reports/{{report1Id}}/resolve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-06] Student calling PATCH /question-reports/:id/resolve returns 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-07 [Negative - EP/BVA] Teacher Rejects status=pending Or Short resolutionNote (< 10 Chars -> 400)",
          "request": {
            "auth": { "type": "noauth" },
