        {
          "name": "TC-T4-12 [Positive - Privacy & Re-Report] Student 2 Sees Bulk-Resolved Feedback (Hiding resolvedBy) & Can Submit New Report",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{student2Token}}" }],
            "url": "{{baseUrl}}/question-reports/my?page=1&limit=10&status=resolved"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-12] Student 2 sees sibling report resolved with resolutionNote and hidden resolvedBy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.total).to.eql(1);",
                  "    pm.expect(res.items[0].status).to.eql('resolved');",
                  "    pm.expect(res.items[0].resolutionNote).to.eql('Đã bổ sung lời thoại và giải thích chi tiết cho câu Part 3.');",
                  "    pm.expect(res.items[0]).to.not.have.property('resolvedBy');",
                  "    pm.expect(res.items[0]).to.not.have.property('resolvedById');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
