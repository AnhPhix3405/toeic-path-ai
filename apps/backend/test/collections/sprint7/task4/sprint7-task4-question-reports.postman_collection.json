        {
          "name": "TC-T4-03d [Negative - Security] Block Student 2 From Reporting Using Student 1 attemptId (403 ERR_FORBIDDEN_ATTEMPT_ACCESS)",
          "request": {
            "auth": { "type": "noauth" },
