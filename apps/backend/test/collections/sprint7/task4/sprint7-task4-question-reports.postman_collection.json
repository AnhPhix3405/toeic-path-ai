    {
      "name": "01 - Report Creation Boundaries, Attempt Context Guards & Anti-Spam Index (UC29 - BVA, EP, ST)",
      "item": [
        {
          "name": "TC-T4-01 [Negative - BVA] Reject description With 9 Trimmed Chars When reason=other (Just Below Min 10)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"other\",\n  \"description\": \"   123456789   \"\n}"
            },
            "url": "{{baseUrl}}/questions/{{q1Id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-01] 9-character trimmed description when reason=other returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-02 [Negative - EP] Reject Whitespace-Only description When reason=other (PMR 031)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"other\",\n  \"description\": \"               \"\n}"
            },
            "url": "{{baseUrl}}/questions/{{q1Id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-02] Whitespace-only description when reason=other returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-03a [Setup] Start Exam Attempt for Student 1 (in_progress)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{fullExamId}}\",\n  \"mode\": \"full_exam\"\n}"
            },
            "url": "{{baseUrl}}/exam-attempts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Start attempt for Student 1 returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.collectionVariables.set('inProgressAttemptId', pm.response.json().attemptId);",
                  "    pm.collectionVariables.set('submittedAttemptId', pm.response.json().attemptId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-03b [Negative - ST] Block Report With Unsubmitted attemptId (400 ERR_ATTEMPT_NOT_SUBMITTED)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student1Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"wrong_answer\",\n  \"attemptId\": \"{{inProgressAttemptId}}\"\n}"
            },
            "url": "{{baseUrl}}/questions/{{q1Id}}/reports"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-03b] Reporting with unsubmitted attemptId returns 400 ERR_ATTEMPT_NOT_SUBMITTED', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errorCode).to.eql('ERR_ATTEMPT_NOT_SUBMITTED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-03c [Setup] Submit Attempt for Student 1",
          "request": {
            "auth": { "type": "noauth" },
