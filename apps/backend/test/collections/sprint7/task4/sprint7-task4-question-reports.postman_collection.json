                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-10b [Positive - DT/Bulk] Teacher Resolves With resolveAllForQuestion=true Closing Both Reports Atomically",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"resolutionNote\": \"   Đã bổ sung lời thoại và giải thích chi tiết cho câu Part 3.   \",\n  \"resolveAllForQuestion\": true\n}"
            },
            "url": "{{baseUrl}}/question-reports/{{report1Id}}/resolve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-10b] Bulk resolve closes sibling open report (bulkResolvedCount=1) and records resolvedAt', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('resolved');",
                  "    pm.expect(res.resolutionNote).to.eql('Đã bổ sung lời thoại và giải thích chi tiết cho câu Part 3.');",
                  "    pm.expect(res.bulkResolvedCount).to.eql(1);",
                  "    pm.expect(res.resolvedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-11 [Negative - ST] Teacher Blocked From Modifying Already Closed Report (400 ERR_REPORT_ALREADY_CLOSED)",
