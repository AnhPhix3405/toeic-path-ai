              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"resolved\",\n  \"resolutionNote\": \"  123456789  \"\n}"
            },
            "url": "{{baseUrl}}/question-reports/{{report1Id}}/resolve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-07] 9-character trimmed resolutionNote when status=resolved returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-08a [Positive - Detail Context] Teacher Views Report Detail With QuestionGroup Context (Part 3)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": "{{baseUrl}}/question-reports/{{report1Id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-08a] GET /question-reports/:id includes questionGroup context and transcript for Part 3', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.question.questionGroup).to.be.an('object');",
                  "    pm.expect(res.question.questionGroup.title).to.eql('TEST_POSTMAN_SPR7_Group_Part_3');",
                  "    pm.expect(res.question.questionGroup.transcript).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-T4-08b [Positive - ST] Teacher Transitions Report pending -> in_review Keeping resolvedById=null & resolvedAt=null",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{teacherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_review\"\n}"
            },
            "url": "{{baseUrl}}/question-reports/{{report1Id}}/resolve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC-T4-08b] Transition to in_review keeps resolvedById=null and resolvedAt=null (SLA accuracy)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.status).to.eql('in_review');",
                  "    pm.expect(res.resolvedById).to.be.null;",
                  "    pm.expect(res.resolvedAt).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
