      "name": "01 - Real-time Saving & Conditional Upsert",
      "item": [
        {
          "name": "01.1 - Save Option for Question 1",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{question1Id}}\",\n  \"selectedOptionId\": \"{{option1AId}}\",\n  \"isMarkedForReview\": false,\n  \"timeSpentSeconds\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{attemptId}}", "answers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Save answer returns 200 OK and answeredCount increments', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.questionId).to.eql(pm.collectionVariables.get('question1Id'));",
                  "    pm.expect(res.selectedOptionId).to.eql(pm.collectionVariables.get('option1AId'));",
                  "    pm.expect(res.answeredCount).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 - Explicit Uncheck Decrements answeredCount",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{question1Id}}\",\n  \"selectedOptionId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{attemptId}}", "answers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Explicit uncheck sets selectedOptionId null and decrements count', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.selectedOptionId).to.be.null;",
                  "    pm.expect(res.answeredCount).to.eql(0);",
