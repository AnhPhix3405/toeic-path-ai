    {
      "name": "03 - Batch Recovery & Chronology Sync",
      "item": [
        {
          "name": "03.1 - Batch Save Answers with Chronology Sync & Glitch Resilience",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{question1Id}}\",\n      \"selectedOptionId\": \"{{option1AId}}\",\n      \"isMarkedForReview\": false,\n      \"timeSpentSeconds\": 20,\n      \"clientAnsweredAt\": \"2026-11-06T04:00:00.000Z\"\n    },\n    {\n      \"questionId\": \"20000000-0000-4000-8000-000000000099\",\n      \"selectedOptionId\": \"30000000-0000-4000-8000-000000000099\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers/batch",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{attemptId}}", "answers", "batch"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Batch save recovers valid answers and isolates failed items', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.syncedCount).to.eql(1);",
                  "    pm.expect(res.failedCount).to.eql(1);",
                  "    pm.expect(res.failedItems).to.be.an('array');",
                  "    pm.expect(res.failedItems[0].reason).to.eql('ERR_QUESTION_NOT_IN_ATTEMPT');",
                  "    pm.expect(res.answeredCount).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Lifecycle Guards & Strict Authorization",
      "item": [
        {
          "name": "04.1 - Admin Cannot Save Answer for Student Returns 403",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{question1Id}}\",\n  \"selectedOptionId\": \"{{option1AId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{attemptId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{attemptId}}", "answers"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin blocked from saving student answers with 403 ERR_FORBIDDEN_ATTEMPT_ACCESS', function () {",
                  "    pm.response.to.have.status(403);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.errorCode).to.eql('ERR_FORBIDDEN_ATTEMPT_ACCESS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04.2 - Student 2 Cannot Save Answer for Student 1 Returns 403",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{student2Token}}", "type": "string" }]
