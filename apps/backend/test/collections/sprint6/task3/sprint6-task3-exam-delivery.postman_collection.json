          "name": "05.1 - Abandon Part Practice Attempt",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{practiceAttemptId}}/abandon",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{practiceAttemptId}}", "abandon"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Abandon practice attempt returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.abandonedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}