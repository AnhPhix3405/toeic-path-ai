    {
      "name": "04 - Split-view Context & UI Optimization",
      "item": [
        {
          "name": "04.1 - Verify Question Group & Passage Text Context Delivery",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{practiceAttemptId}}/questions?partNumber=6",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{practiceAttemptId}}", "questions"],
              "query": [{ "key": "partNumber", "value": "6" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Question group delivers passageText and linked questions have no answer leak', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.questionGroups.length).to.be.above(0);",
                  "    const group = res.questionGroups[0];",
                  "    pm.expect(group.id).to.be.a('string');",
                  "    pm.expect(group.passageText).to.be.a('string');",
                  "    res.questions.forEach(q => {",
                  "        pm.expect(q.options.length).to.be.above(0);",
                  "        q.options.forEach(opt => {",
                  "            pm.expect(opt).to.not.have.property('isCorrect');",
                  "            pm.expect(opt.id).to.be.a('string');",
                  "            pm.expect(opt.label).to.be.a('string');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04.2 - Verify Overview Matrix questionsProgress Completeness",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/exam-attempts/{{practiceAttemptId}}",
              "host": ["{{baseUrl}}"],
              "path": ["exam-attempts", "{{practiceAttemptId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Overview returns questionsProgress matrix and remainingSeconds', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.remainingSeconds).to.be.a('number');",
                  "    pm.expect(res.questionsProgress).to.be.an('array');",
                  "    pm.expect(res.questionsProgress.length).to.eql(res.totalQuestions);",
                  "    res.questionsProgress.forEach(qp => {",
                  "        pm.expect(qp).to.have.property('questionId');",
                  "        pm.expect(qp).to.have.property('partNumber');",
                  "        pm.expect(qp).to.have.property('orderIndex');",
                  "        pm.expect(qp).to.have.property('isAnswered');",
                  "        pm.expect(qp).to.have.property('isMarkedForReview');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
