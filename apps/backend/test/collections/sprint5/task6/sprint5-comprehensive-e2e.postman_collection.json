    {
      "name": "01 - Exam Configuration & Auto-seeding (UC16)",
      "item": [
        {
          "name": "01.1 - Create Full Test -> Auto-seeding 7 Sections",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_E2E_FullTest_Master_01\",\n  \"description\": \"Đề thi thử Full Test toàn diện Master\",\n  \"type\": \"full_test\",\n  \"durationMinutes\": 120,\n  \"allowPartPractice\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams", "host": ["{{baseUrl}}"], "path": ["exams"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Full Test succeeds with 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.be.a('string');",
                  "    pm.expect(res.sectionsCount).to.eql(7);",
                  "    pm.expect(res.sections.length).to.eql(7);",
                  "    pm.expect(res.status).to.eql('draft');",
                  "    pm.collectionVariables.set('examId', res.id);",
                  "    pm.collectionVariables.set('examVersion', res.version);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.2 - Update Exam Configuration with Optimistic Locking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_E2E_FullTest_Master_Updated\",\n  \"version\": {{examVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["exams", "{{examId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Update config succeeds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.title).to.eql('TEST_E2E_FullTest_Master_Updated');",
                  "    pm.collectionVariables.set('examVersion', res.version);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01.3 - Optimistic Locking Conflict (Wrong Version)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_E2E_Conflict\",\n  \"version\": 999\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{examId}}", "host": ["{{baseUrl}}"], "path": ["exams", "{{examId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Exam Structure & Question Selection (UC17)",
      "item": [
        {
          "name": "02.1 - Create Placement Test",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_E2E_PlacementTest_01\",\n  \"type\": \"placement_test\",\n  \"durationMinutes\": 60\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams", "host": ["{{baseUrl}}"], "path": ["exams"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create Placement Test succeeds with 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('placementExamId', res.id);",
                  "    pm.collectionVariables.set('placementExamVersion', res.version);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02.2 - Get Detailed Management View",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/exams/{{examId}}/manage", "host": ["{{baseUrl}}"], "path": ["exams", "{{examId}}", "manage"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get management view succeeds 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.id).to.eql(pm.collectionVariables.get('examId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Publishing Checklist & Lifecycle (UC18)",
      "item": [
        {
          "name": "03.1 - Reject Publishing When Questions Are Insufficient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{examVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{examId}}/publish", "host": ["{{baseUrl}}"], "path": ["exams", "{{examId}}", "publish"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reject publish with 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03.2 - Close Draft/Exam Directly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{placementExamVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{placementExamId}}/close", "host": ["{{baseUrl}}"], "path": ["exams", "{{placementExamId}}", "close"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Close exam response', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Public & Management Catalogs (UC19)",
      "item": [
        {
          "name": "04.1 - Get Public Catalog (Guest / Optional Auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/exams?limit=10&page=1", "host": ["{{baseUrl}}"], "path": ["exams"], "query": [{ "key": "limit", "value": "10" }, { "key": "page", "value": "1" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Public Catalog returns standardized envelope 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.items).to.be.an('array');",
                  "    pm.expect(res.total).to.be.a('number');",
                  "    pm.expect(res.limit).to.eql(10);",
                  "    pm.expect(res.page).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04.2 - Public Catalog Hard Limit 50 (Tech Debt 003)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/exams?limit=51", "host": ["{{baseUrl}}"], "path": ["exams"], "query": [{ "key": "limit", "value": "51" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Limit > 50 returns 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04.3 - Management Catalog (Teacher / Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/exams/manage?limit=10&page=1", "host": ["{{baseUrl}}"], "path": ["exams", "manage"], "query": [{ "key": "limit", "value": "10" }, { "key": "page", "value": "1" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Management Catalog returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Perimeter Defenses & RBAC Protection",
      "item": [
        {
          "name": "05.1 - Student Blocked From Creating Exams",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"TEST_E2E_Student_Hacker\",\n  \"type\": \"full_test\",\n  \"durationMinutes\": 120\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams", "host": ["{{baseUrl}}"], "path": ["exams"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Student is blocked with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05.2 - Student Blocked From Management Catalog",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/exams/manage", "host": ["{{baseUrl}}"], "path": ["exams", "manage"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Student blocked from manage catalog 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
