{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4789-0123-abcdef456789",
    "name": "TOEIC Path AI - Sprint 5 Comprehensive Master E2E Collection",
    "description": "Master Postman Automated Test Collection kiểm thử tự động toàn diện cho toàn bộ Sprint 5 (UC16: Quản lý & Khởi tạo đề thi, UC17: Thiết lập cấu trúc & Tuyển chọn câu hỏi, UC18: Thẩm định xuất bản & Vòng đời đề thi, UC19: Tra cứu danh mục công khai/quản trị & Zero Answer Leakage Overview). Thiết kế theo chuẩn Zero-Configuration / One-Touch tự động lấy token và dọn dẹp biến môi trường.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{teacherToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api/v1", "type": "string" },
    { "key": "studentEmail", "value": "sprint5.master.student@example.com", "type": "string" },
    { "key": "teacherEmail", "value": "sprint5.task2.teacher@example.com", "type": "string" },
    { "key": "testPassword", "value": "StrongPassword123!", "type": "string" },
    { "key": "adminEmail", "value": "admin@example.com", "type": "string" },
    { "key": "adminPassword", "value": "StrongPassword123!", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "teacherToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "examId", "value": "", "type": "string" },
    { "key": "examVersion", "value": "1", "type": "string" },
    { "key": "placementExamId", "value": "", "type": "string" },
    { "key": "placementExamVersion", "value": "1", "type": "string" }
