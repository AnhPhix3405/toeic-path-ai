              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invalid Schedule Exam [S5T2]\",\n  \"type\": \"full_test\",\n  \"durationMinutes\": 120,\n  \"openAt\": \"2026-12-31T00:00:00.000Z\",\n  \"closeAt\": \"2026-10-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exams",
              "host": ["{{baseUrl}}"],
              "path": ["exams"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Schedule validation rejected (400)\", function () {",
                  "  pm.response.to.have.status(400);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(\"ERR_INVALID_SCHEDULE_TIME\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
