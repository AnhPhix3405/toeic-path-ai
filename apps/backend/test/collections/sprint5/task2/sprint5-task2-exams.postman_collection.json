    {
      "name": "03 - Update Exam Configuration (PATCH /exams/:id)",
      "item": [
        {
          "name": "03.1 - Teacher Update Exam Title & Duration (Optimistic Lock Match)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{fullTestExamVersion}},\n  \"title\": \"ETS TOEIC 2026 Test 01 - Updated [S5T2]\",\n  \"durationMinutes\": 125\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exams/{{fullTestExamId}}",
              "host": ["{{baseUrl}}"],
              "path": ["exams", "{{fullTestExamId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Exam updated successfully & version incremented (200)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.title).to.eql(\"ETS TOEIC 2026 Test 01 - Updated [S5T2]\");",
                  "  pm.expect(json.durationMinutes).to.eql(125);",
                  "  pm.expect(json.version).to.eql(Number(pm.collectionVariables.get(\"fullTestExamVersion\")) + 1);",
                  "  pm.collectionVariables.set(\"fullTestExamVersion\", json.version);",
                  "});"
                ],
