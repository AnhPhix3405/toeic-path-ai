        {
          "name": "01.6 - RBAC Guard: Student Cannot Create Exam",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Student Unauthorized Exam [S5T2]\",\n  \"type\": \"mini_test\",\n  \"durationMinutes\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exams",
              "host": ["{{baseUrl}}"],
              "path": ["exams"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Student blocked from creating exam (403)\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
