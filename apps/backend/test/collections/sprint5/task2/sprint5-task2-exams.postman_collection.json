    {
      "name": "01 - Create Exam (POST /exams)",
      "item": [
        {
          "name": "01.1 - Create Full Test (Auto-seed 7 Sections)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ETS TOEIC 2026 Test 01 [S5T2]\",\n  \"description\": \"Đề thi thử TOEIC chuẩn format 2026 gồm 200 câu trong 120 phút.\",\n  \"type\": \"full_test\",\n  \"durationMinutes\": 120,\n  \"maxAttempts\": 3,\n  \"passingScore\": 600,\n  \"allowPartPractice\": true,\n  \"isShuffledQuestions\": false,\n  \"isShuffledOptions\": false,\n  \"scoreConversionType\": \"DEFAULT_ETS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exams",
              "host": ["{{baseUrl}}"],
              "path": ["exams"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Full Test created successfully (201)\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a(\"string\");",
                  "  pm.expect(json.type).to.eql(\"full_test\");",
                  "  pm.expect(json.status).to.eql(\"draft\");",
                  "  pm.expect(json.version).to.eql(1);",
                  "  pm.expect(json.sectionsCount).to.eql(7);",
                  "  pm.expect(json.sections).to.be.an(\"array\").with.lengthOf(7);",
                  "  pm.expect(json.sections[0].targetQuestionsCount).to.eql(6);",
                  "  pm.expect(json.sections[6].targetQuestionsCount).to.eql(54);",
                  "  pm.collectionVariables.set(\"fullTestExamId\", json.id);",
                  "  pm.collectionVariables.set(\"fullTestExamVersion\", json.version);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "01.2 - Create Mini Test (No Auto-seeding)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
