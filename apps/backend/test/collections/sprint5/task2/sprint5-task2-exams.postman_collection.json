              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Teacher registered or already exists (201/409)\", function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
