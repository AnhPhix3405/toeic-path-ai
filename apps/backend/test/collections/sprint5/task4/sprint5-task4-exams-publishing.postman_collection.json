              "script": {
                "exec": [
                  "pm.test(\"Found teacher user in admin directory (200)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  var users = json.data || json.items || (Array.isArray(json) ? json : []);",
                  "  var teacher = users.find(function (u) { return u.email === pm.collectionVariables.get(\"teacherEmail\"); });",
