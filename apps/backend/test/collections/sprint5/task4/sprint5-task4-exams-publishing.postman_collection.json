    {
      "name": "01 - Publish Checklist Validator (POST /exams/:id/publish)",
      "item": [
        {
          "name": "01.1 - Error: Publish Checklist Rejects Incomplete Full Test",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{emptyExamVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{emptyExamId}}/publish", "host": ["{{baseUrl}}"], "path": ["exams", "{{emptyExamId}}", "publish"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rejects empty full test (400 ERR_EXAM_INCOMPLETE_QUESTIONS)\", function () {",
                  "  pm.response.to.have.status(400);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.equal(\"ERR_EXAM_INCOMPLETE_QUESTIONS\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "01.2 - Error: Optimistic Locking Stale Version on Publish",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 999\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{scheduledExamId}}/publish", "host": ["{{baseUrl}}"], "path": ["exams", "{{scheduledExamId}}", "publish"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Stale version publish rejected (409 ERR_CONCURRENCY_CONFLICT)\", function () {",
                  "  pm.response.to.have.status(409);",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.equal(\"ERR_CONCURRENCY_CONFLICT\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "01.3 - RBAC Guard: Student Cannot Publish Exam",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{scheduledExamVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{scheduledExamId}}/publish", "host": ["{{baseUrl}}"], "path": ["exams", "{{scheduledExamId}}", "publish"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Student forbidden to publish exam (403)\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "01.4 - Teacher Publish Scheduled Exam (Computed Status isScheduled=true)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{scheduledExamVersion}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/exams/{{scheduledExamId}}/publish", "host": ["{{baseUrl}}"], "path": ["exams", "{{scheduledExamId}}", "publish"] }
          },
          "event": [
            {
              "listen": "test",
